{
  "components": {
    "schemas": {
      "ActionItemRequest": {
        "properties": {
          "priority": {
            "default": "medium",
            "pattern": "^(low|medium|high|critical)$",
            "title": "Priority",
            "type": "string"
          },
          "repository": {
            "maxLength": 200,
            "minLength": 3,
            "title": "Repository",
            "type": "string"
          },
          "title": {
            "maxLength": 240,
            "minLength": 3,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "repository",
          "title"
        ],
        "title": "ActionItemRequest",
        "type": "object"
      },
      "AnalysisRequest": {
        "properties": {
          "repository": {
            "examples": [
              "fastapi/fastapi"
            ],
            "maxLength": 140,
            "title": "Repository",
            "type": "string"
          }
        },
        "required": [
          "repository"
        ],
        "title": "AnalysisRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Repository intelligence through REST and MCP.",
    "title": "Quorum Git Agent",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
